rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow reading test document during connection validation
    match /test/connection {
      allow read: if true;
    }

    match /signals/{signalId} {
      allow read: if true;
      allow write: if true; // In production this should be restricted
    }
  }
}
